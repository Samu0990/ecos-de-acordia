#!/bin/bash
cd ~/Unity/ParkourLab
unity command recompile >/dev/null 2>&1
sleep 4
for i in $(seq 1 60); do
  s=$(unity --json command recompile_status 2>&1)
  r=$(echo "$s" | python3 -c 'import sys,json; print(json.loads(sys.stdin.read())["data"]["result"])' 2>/dev/null)
  [ -n "$r" ] && ! echo "$r" | grep -q '"compiling"' && break
  sleep 3
done
echo "$r" | head -c 3000; echo
